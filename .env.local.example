NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required only for /employees account management (create/deactivate cashier
# logins via the Supabase Auth Admin API). Never prefix with NEXT_PUBLIC_ —
# this key bypasses RLS entirely and must never reach the browser. Never
# commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
